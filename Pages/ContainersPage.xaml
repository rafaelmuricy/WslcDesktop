<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WslcDesktop.Pages.ContainersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:WslcDesktop.Models"
    mc:Ignorable="d"
    Loaded="ContainersPage_Loaded">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="8">
            <TextBlock
                Style="{StaticResource TitleTextBlockStyle}"
                Text="Containers" />
            <TextBlock
                Style="{StaticResource BodyTextBlockStyle}"
                Text="List of WSLC containers." />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="320" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <AutoSuggestBox
                x:Name="SearchBox"
                MinHeight="36"
                PlaceholderText="Search"
                QueryIcon="Find"
                TextChanged="SearchBox_TextChanged" />

            <ToggleSwitch
                x:Name="OnlyRunningToggle"
                Grid.Column="1"
                VerticalAlignment="Center"
                OffContent="Only running"
                OnContent="Only running"
                Toggled="OnlyRunningToggle_Toggled" />

            <Button
                Grid.Column="3"
                Width="40"
                Height="36"
                Click="RefreshButton_Click"
                Style="{StaticResource AccentIconButtonStyle}"
                ToolTipService.ToolTip="Refresh">
                <FontIcon FontSize="16" Glyph="&#xE72C;" />
            </Button>
        </Grid>

        <Grid Grid.Row="2">
            <ProgressRing
                x:Name="LoadingRing"
                Width="40"
                Height="40"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsActive="True" />

            <TextBlock
                x:Name="StatusText"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource BodyTextBlockStyle}"
                TextWrapping="WrapWholeWords"
                Visibility="Collapsed" />

            <ListView
                x:Name="ContainersList"
                IsItemClickEnabled="True"
                ItemClick="ContainersList_ItemClick"
                SelectionMode="None"
                Visibility="Collapsed">
                <ListView.Header>
                    <Grid Padding="12,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="Auto" MinWidth="132" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Width="12"
                            ToolTipService.ToolTip="Container status" />
                        <TextBlock
                            Grid.Column="1"
                            FontWeight="SemiBold"
                            Text="CONTAINER ID"
                            ToolTipService.ToolTip="Unique container identifier" />
                        <TextBlock
                            Grid.Column="2"
                            FontWeight="SemiBold"
                            Text="NAME"
                            ToolTipService.ToolTip="Container name" />
                        <TextBlock
                            Grid.Column="3"
                            FontWeight="SemiBold"
                            Text="IMAGE"
                            ToolTipService.ToolTip="Image used by the container" />
                        <TextBlock
                            Grid.Column="4"
                            FontWeight="SemiBold"
                            Text="CREATED"
                            ToolTipService.ToolTip="When the container was created" />
                        <TextBlock
                            Grid.Column="5"
                            FontWeight="SemiBold"
                            Text="STATUS"
                            ToolTipService.ToolTip="Current container status" />
                        <TextBlock
                            Grid.Column="6"
                            FontWeight="SemiBold"
                            Text="PORTS"
                            ToolTipService.ToolTip="Published port mappings" />
                        <TextBlock
                            Grid.Column="7"
                            FontWeight="SemiBold"
                            Text="ACTIONS"
                            ToolTipService.ToolTip="Available actions" />
                    </Grid>
                </ListView.Header>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:ContainerInstance">
                        <Grid Padding="0,2" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="16" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="Auto" MinWidth="132" />
                            </Grid.ColumnDefinitions>
                            <Grid
                                Width="12"
                                Height="12"
                                VerticalAlignment="Center"
                                ToolTipService.ToolTip="{x:Bind StatusDisplay}">
                                <Ellipse
                                    Width="10"
                                    Height="10"
                                    Fill="#22C55E"
                                    Opacity="{x:Bind RunningDotOpacity}" />
                                <Ellipse
                                    Width="10"
                                    Height="10"
                                    Fill="Transparent"
                                    Opacity="{x:Bind StoppedDotOpacity}"
                                    Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                                    StrokeThickness="1.5" />
                            </Grid>
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontFamily="Consolas"
                                Text="{x:Bind ShortId}"
                                ToolTipService.ToolTip="{x:Bind Id}" />
                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Text="{x:Bind Name}"
                                TextTrimming="CharacterEllipsis"
                                ToolTipService.ToolTip="{x:Bind Name}" />
                            <TextBlock
                                Grid.Column="3"
                                VerticalAlignment="Center"
                                Text="{x:Bind Image}"
                                TextTrimming="CharacterEllipsis"
                                ToolTipService.ToolTip="{x:Bind Image}" />
                            <TextBlock
                                Grid.Column="4"
                                VerticalAlignment="Center"
                                Text="{x:Bind CreatedDisplay}"
                                TextTrimming="CharacterEllipsis"
                                ToolTipService.ToolTip="{x:Bind CreatedDisplay}" />
                            <TextBlock
                                Grid.Column="5"
                                VerticalAlignment="Center"
                                Text="{x:Bind StatusDisplay}"
                                TextTrimming="CharacterEllipsis"
                                ToolTipService.ToolTip="{x:Bind StatusDisplay}" />
                            <TextBlock
                                Grid.Column="6"
                                VerticalAlignment="Center"
                                Text="{x:Bind PortsDisplay}"
                                TextTrimming="CharacterEllipsis"
                                ToolTipService.ToolTip="{x:Bind PortsDisplay}" />
                            <StackPanel
                                Grid.Column="7"
                                Orientation="Horizontal"
                                Spacing="4">
                                <Button
                                    Width="36"
                                    Height="32"
                                    Click="StartStopContainerButton_Click"
                                    Style="{StaticResource AccentIconButtonStyle}"
                                    Tag="{x:Bind ShortId}"
                                    ToolTipService.ToolTip="{x:Bind StartStopTooltip}">
                                    <FontIcon FontSize="14" Glyph="{x:Bind StartStopGlyph}" />
                                </Button>
                                <Button
                                    Width="36"
                                    Height="32"
                                    Style="{StaticResource AccentIconButtonStyle}"
                                    ToolTipService.ToolTip="Container actions">
                                    <FontIcon
                                        FontSize="14"
                                        Glyph="&#xE712;"
                                        RenderTransformOrigin="0.5,0.5">
                                        <FontIcon.RenderTransform>
                                            <RotateTransform Angle="90" />
                                        </FontIcon.RenderTransform>
                                    </FontIcon>
                                </Button>
                                <Button
                                    Width="36"
                                    Height="32"
                                    Click="DeleteContainerButton_Click"
                                    Style="{StaticResource AccentIconButtonStyle}"
                                    Tag="{x:Bind ShortId}"
                                    ToolTipService.ToolTip="Delete container">
                                    <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="12,0" />
                        <Setter Property="MinHeight" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>
        </Grid>
    </Grid>
</Page>
