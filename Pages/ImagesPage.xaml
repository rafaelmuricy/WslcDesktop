<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WslcDesktop.Pages.ImagesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:WslcDesktop.Models"
    mc:Ignorable="d"
    Loaded="ImagesPage_Loaded">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="8">
            <TextBlock
                Style="{StaticResource TitleTextBlockStyle}"
                Text="Images" />
            <TextBlock
                Style="{StaticResource BodyTextBlockStyle}"
                Text="List of WSLC images." />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="320" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <AutoSuggestBox
                x:Name="SearchBox"
                MinHeight="36"
                PlaceholderText="Search"
                QueryIcon="Find"
                TextChanged="SearchBox_TextChanged" />

            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    Width="40"
                    Height="36"
                    Click="AddImageButton_Click"
                    Style="{StaticResource AccentIconButtonStyle}"
                    ToolTipService.ToolTip="Load Dockerfile/Containerfile">
                    <FontIcon FontSize="16" Glyph="&#xE710;" />
                </Button>
                <Button
                    Width="40"
                    Height="36"
                    Click="RefreshButton_Click"
                    Style="{StaticResource AccentIconButtonStyle}"
                    ToolTipService.ToolTip="Refresh">
                    <FontIcon FontSize="16" Glyph="&#xE72C;" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <ProgressRing
                x:Name="LoadingRing"
                Width="40"
                Height="40"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsActive="True" />

            <TextBlock
                x:Name="StatusText"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource BodyTextBlockStyle}"
                TextWrapping="WrapWholeWords"
                Visibility="Collapsed" />

            <ListView
                x:Name="ImagesList"
                IsItemClickEnabled="False"
                SelectionMode="None"
                Visibility="Collapsed">
                <ListView.Header>
                    <Grid Padding="12,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" MinWidth="132" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            FontWeight="SemiBold"
                            Text="NAME"
                            ToolTipService.ToolTip="Image name" />
                        <TextBlock
                            Grid.Column="1"
                            FontWeight="SemiBold"
                            Text="TAG"
                            ToolTipService.ToolTip="Image tag" />
                        <TextBlock
                            Grid.Column="2"
                            FontWeight="SemiBold"
                            Text="IMAGE ID"
                            ToolTipService.ToolTip="Unique image identifier" />
                        <TextBlock
                            Grid.Column="3"
                            FontWeight="SemiBold"
                            Text="CREATED"
                            ToolTipService.ToolTip="When the image was created" />
                        <TextBlock
                            Grid.Column="4"
                            FontWeight="SemiBold"
                            Text="SIZE"
                            ToolTipService.ToolTip="Image size" />
                        <TextBlock
                            Grid.Column="5"
                            FontWeight="SemiBold"
                            Text="ACTIONS"
                            ToolTipService.ToolTip="Available actions" />
                    </Grid>
                </ListView.Header>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:ContainerImage">
                        <Grid Padding="0,2" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" MinWidth="132" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                Text="{x:Bind Name}"
                                TextTrimming="CharacterEllipsis"
                                ToolTipService.ToolTip="{x:Bind Name}" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Text="{x:Bind Tag}"
                                TextTrimming="CharacterEllipsis"
                                ToolTipService.ToolTip="{x:Bind Tag}" />
                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontFamily="Consolas"
                                Text="{x:Bind ShortId}"
                                ToolTipService.ToolTip="{x:Bind Id}" />
                            <TextBlock
                                Grid.Column="3"
                                VerticalAlignment="Center"
                                Text="{x:Bind CreatedDisplay}"
                                TextTrimming="CharacterEllipsis"
                                ToolTipService.ToolTip="{x:Bind CreatedDisplay}" />
                            <TextBlock
                                Grid.Column="4"
                                VerticalAlignment="Center"
                                Text="{x:Bind SizeDisplay}"
                                ToolTipService.ToolTip="{x:Bind SizeDisplay}" />
                            <StackPanel
                                Grid.Column="5"
                                Orientation="Horizontal"
                                Spacing="4">
                                <Button
                                    Width="36"
                                    Height="32"
                                    Click="RunImageButton_Click"
                                    Style="{StaticResource AccentIconButtonStyle}"
                                    Tag="{x:Bind FullName}"
                                    ToolTipService.ToolTip="Run">
                                    <FontIcon FontSize="14" Glyph="&#xE768;" />
                                </Button>
                                <Button
                                    Width="36"
                                    Height="32"
                                    Style="{StaticResource AccentIconButtonStyle}"
                                    ToolTipService.ToolTip="Image Actions">
                                    <FontIcon
                                        FontSize="14"
                                        Glyph="&#xE712;"
                                        RenderTransformOrigin="0.5,0.5">
                                        <FontIcon.RenderTransform>
                                            <RotateTransform Angle="90" />
                                        </FontIcon.RenderTransform>
                                    </FontIcon>
                                </Button>
                                <Button
                                    Width="36"
                                    Height="32"
                                    Click="DeleteImageButton_Click"
                                    Style="{StaticResource AccentIconButtonStyle}"
                                    Tag="{x:Bind ShortId}"
                                    ToolTipService.ToolTip="Delete Image">
                                    <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="12,0" />
                        <Setter Property="MinHeight" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>
        </Grid>
    </Grid>
</Page>
