<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WslcDesktop.Pages.ContainerDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="ContainerDetailsPage_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Padding="24,16,24,8" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Breadcrumb -->
            <StackPanel Orientation="Horizontal" Spacing="6">
                <HyperlinkButton
                    Padding="0"
                    Click="BreadcrumbContainers_Click"
                    Content="Containers"
                    FontSize="13" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="13"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="/" />
                <TextBlock
                    x:Name="BreadcrumbNameText"
                    VerticalAlignment="Center"
                    FontSize="13"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="—" />
            </StackPanel>

            <!-- Header -->
            <Grid Grid.Row="1" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button
                        Width="36"
                        Height="36"
                        VerticalAlignment="Top"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="BackButton_Click"
                        ToolTipService.ToolTip="Back">
                        <FontIcon FontSize="16" Glyph="&#xE72B;" />
                    </Button>

                    <Border
                        Grid.Column="1"
                        Width="40"
                        Height="40"
                        VerticalAlignment="Top"
                        Background="#1A7C3AED"
                        CornerRadius="8">
                        <FontIcon
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="20"
                            Foreground="{StaticResource AppAccentBrush}"
                            Glyph="&#xE7B8;" />
                    </Border>

                    <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center">
                        <TextBlock
                            x:Name="ContainerNameText"
                            FontSize="28"
                            FontWeight="SemiBold"
                            Text="—"
                            TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Glyph="&#xE8B7;" />
                                <TextBlock
                                    x:Name="ContainerIdText"
                                    VerticalAlignment="Center"
                                    FontFamily="Consolas"
                                    FontSize="13"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="—" />
                                <Button
                                    Width="28"
                                    Height="28"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="CopyIdButton_Click"
                                    ToolTipService.ToolTip="Copy ID">
                                    <FontIcon FontSize="12" Glyph="&#xE8C8;" />
                                </Button>
                            </StackPanel>
                            <TextBlock
                                x:Name="ContainerImageText"
                                VerticalAlignment="Center"
                                FontSize="13"
                                Foreground="{StaticResource AppAccentBrush}"
                                Text="—"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <StackPanel
                    Grid.Column="1"
                    MinWidth="160"
                    VerticalAlignment="Center"
                    Spacing="2">
                    <TextBlock
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="STATUS" />
                    <TextBlock
                        x:Name="StatusText"
                        FontSize="14"
                        Text="—" />
                </StackPanel>

                <StackPanel
                    Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button
                            x:Name="StopButton"
                            Width="40"
                            Height="36"
                            Click="StopButton_Click"
                            Style="{StaticResource AccentIconButtonStyle}"
                            ToolTipService.ToolTip="Stop">
                            <FontIcon FontSize="14" Glyph="&#xE71A;" />
                        </Button>
                        <Button
                            x:Name="StartButton"
                            Width="40"
                            Height="36"
                            Click="StartButton_Click"
                            Style="{StaticResource AccentIconButtonStyle}"
                            ToolTipService.ToolTip="Start">
                            <FontIcon FontSize="14" Glyph="&#xE768;" />
                        </Button>
                        <Button
                            x:Name="RestartButton"
                            Width="40"
                            Height="36"
                            Click="RestartButton_Click"
                            Style="{StaticResource AccentIconButtonStyle}"
                            ToolTipService.ToolTip="Restart">
                            <FontIcon FontSize="14" Glyph="&#xE72C;" />
                        </Button>
                    </StackPanel>
                    <Button
                        x:Name="DeleteButton"
                        Width="40"
                        Height="36"
                        Background="{StaticResource AppDangerBrush}"
                        Click="DeleteButton_Click"
                        Foreground="White"
                        ToolTipService.ToolTip="Delete">
                        <FontIcon FontSize="14" Glyph="&#xE74D;" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Tabs -->
            <StackPanel Grid.Row="2" Spacing="0">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button
                        x:Name="LogsTabButton"
                        Padding="12,8"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="TabButton_Click"
                        Tag="Logs">
                        <TextBlock x:Name="LogsTabLabel" FontWeight="SemiBold" Text="Logs" />
                    </Button>
                    <Button
                        x:Name="InspectTabButton"
                        Padding="12,8"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="TabButton_Click"
                        Tag="Inspect">
                        <TextBlock x:Name="InspectTabLabel" Text="Inspect" />
                    </Button>
                    <Button
                        x:Name="BindMountsTabButton"
                        Padding="12,8"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="TabButton_Click"
                        Tag="BindMounts">
                        <TextBlock x:Name="BindMountsTabLabel" Text="Bind mounts" />
                    </Button>
                    <Button
                        x:Name="ExecTabButton"
                        Padding="12,8"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="TabButton_Click"
                        Tag="Exec">
                        <TextBlock x:Name="ExecTabLabel" Text="Exec" />
                    </Button>
                    <Button
                        x:Name="FilesTabButton"
                        Padding="12,8"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="TabButton_Click"
                        Tag="Files">
                        <TextBlock x:Name="FilesTabLabel" Text="Files" />
                    </Button>
                    <Button
                        x:Name="StatsTabButton"
                        Padding="12,8"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="TabButton_Click"
                        Tag="Stats">
                        <TextBlock x:Name="StatsTabLabel" Text="Stats" />
                    </Button>
                </StackPanel>
                <Rectangle
                    Height="1"
                    Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
            </StackPanel>

            <!-- Content -->
            <Grid Grid.Row="3">
                <!-- Logs -->
                <Grid x:Name="LogsPanel">
                    <Border Background="#000000" CornerRadius="4">
                        <Grid>
                            <ScrollViewer
                                x:Name="LogsScrollViewer"
                                Padding="16,12,56,12"
                                HorizontalScrollBarVisibility="Auto"
                                VerticalScrollBarVisibility="Auto">
                                <TextBlock
                                    x:Name="LogsText"
                                    FontFamily="Consolas"
                                    FontSize="12"
                                    Foreground="#D4D4D4"
                                    IsTextSelectionEnabled="True"
                                    TextWrapping="NoWrap" />
                            </ScrollViewer>

                            <Border
                                Width="40"
                                Margin="0,12,12,12"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Background="#CC2D2D2D"
                                CornerRadius="6"
                                Padding="4">
                                <StackPanel Spacing="4">
                                    <Button
                                        Width="32"
                                        Height="32"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="SearchLogsButton_Click"
                                        ToolTipService.ToolTip="Search">
                                        <FontIcon FontSize="14" Foreground="#CCCCCC" Glyph="&#xE721;" />
                                    </Button>
                                    <Button
                                        Width="32"
                                        Height="32"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="CopyLogsButton_Click"
                                        ToolTipService.ToolTip="Copy logs">
                                        <FontIcon FontSize="14" Foreground="#CCCCCC" Glyph="&#xE8C8;" />
                                    </Button>
                                    <Button
                                        x:Name="AutoScrollButton"
                                        Width="32"
                                        Height="32"
                                        Padding="0"
                                        Background="#337C3AED"
                                        BorderThickness="0"
                                        Click="AutoScrollButton_Click"
                                        ToolTipService.ToolTip="Auto-scroll">
                                        <FontIcon FontSize="14" Foreground="White" Glyph="&#xE823;" />
                                    </Button>
                                    <Button
                                        Width="32"
                                        Height="32"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="ClearLogsButton_Click"
                                        ToolTipService.ToolTip="Clear">
                                        <FontIcon FontSize="14" Foreground="#CCCCCC" Glyph="&#xE74D;" />
                                    </Button>
                                </StackPanel>
                            </Border>

                            <Button
                                Width="36"
                                Height="36"
                                Margin="0,0,16,16"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Click="ScrollToBottomButton_Click"
                                Style="{StaticResource AccentIconButtonStyle}"
                                ToolTipService.ToolTip="Scroll to bottom">
                                <FontIcon FontSize="14" Glyph="&#xE74B;" />
                            </Button>
                        </Grid>
                    </Border>

                    <Border
                        x:Name="SearchBar"
                        Margin="16,12,64,0"
                        Padding="8"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Top"
                        Background="#E6222222"
                        CornerRadius="4"
                        Visibility="Collapsed">
                        <TextBox
                            x:Name="SearchBox"
                            PlaceholderText="Search logs..."
                            TextChanged="SearchBox_TextChanged" />
                    </Border>
                </Grid>

                <!-- Inspect -->
                <Border
                    x:Name="InspectPanel"
                    Background="#000000"
                    CornerRadius="4"
                    Visibility="Collapsed">
                    <ScrollViewer Padding="16" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <TextBlock
                            x:Name="InspectText"
                            FontFamily="Consolas"
                            FontSize="12"
                            Foreground="#D4D4D4"
                            IsTextSelectionEnabled="True"
                            TextWrapping="Wrap" />
                    </ScrollViewer>
                </Border>

                <!-- Placeholder panels -->
                <Border
                    x:Name="BindMountsPanel"
                    Padding="24"
                    CornerRadius="4"
                    Visibility="Collapsed">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Bind mounts will appear here." />
                </Border>

                <Border
                    x:Name="ExecPanel"
                    Padding="24"
                    CornerRadius="4"
                    Visibility="Collapsed">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Exec will appear here." />
                </Border>

                <Border
                    x:Name="FilesPanel"
                    Padding="24"
                    CornerRadius="4"
                    Visibility="Collapsed">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Files will appear here." />
                </Border>

                <Border
                    x:Name="StatsPanel"
                    Padding="24"
                    CornerRadius="4"
                    Visibility="Collapsed">
                    <TextBlock
                        x:Name="StatsDetailText"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="Consolas"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Loading stats..." />
                </Border>

                <ProgressRing
                    x:Name="LoadingRing"
                    Width="40"
                    Height="40"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsActive="False"
                    Visibility="Collapsed" />
            </Grid>
        </Grid>

        <!-- Footer -->
        <Border
            Grid.Row="1"
            Padding="16,8"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock
                    x:Name="FooterStatsText"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="RAM —    CPU —    Block I/O: —" />
                <StackPanel
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="8">
                    <FontIcon
                        FontSize="14"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE756;"
                        ToolTipService.ToolTip="Terminal" />
                    <FontIcon
                        FontSize="14"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE946;"
                        ToolTipService.ToolTip="Info" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
